---
/**
 * The mark: an equals sign with a carried digit.
 * The red square is the "carry" — what one result hands to the next.
 */
interface Props {
  size?: number;
  withWordmark?: boolean;
  class?: string;
}
const { size = 28, withWordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect class="logo__carry" x="2" y="8" width="6" height="6" />
    <rect class="logo__bar logo__bar--top" x="11" y="8" width="19" height="6" />
    <rect class="logo__bar" x="2" y="18" width="28" height="6" />
  </svg>
  {
    withWordmark && (
      <span class="logo__word">
        Arithmetic<span class="logo__word-2"> Research</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 620;
    font-size: 1.02rem;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .logo__mark {
    flex: none;
  }
  .logo__bar {
    fill: currentColor;
    transform-box: fill-box;
    transform-origin: 100% 50%;
    transition: transform 0.6s var(--ease-out);
  }
  .logo__carry {
    fill: var(--signal);
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transition: transform 0.6s var(--ease-out);
  }
  :global(a:hover) > .logo .logo__bar--top,
  .logo:hover .logo__bar--top {
    transform: scaleX(0.72);
  }
  :global(a:hover) > .logo .logo__carry,
  .logo:hover .logo__carry {
    transform: translateX(5px) rotate(90deg);
  }
  .logo__word-2 {
    font-weight: 420;
    opacity: 0.62;
  }
</style>
