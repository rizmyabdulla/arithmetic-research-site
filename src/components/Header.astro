---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
import { products } from '../data/products';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'light' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header" data-tone={tone} data-site-header>
  <div class="site-header__bar wrap">
    <a href="/" class="site-header__home" aria-label={`${site.name} — home`}>
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul role="list">
        {
          nav.map((item, i) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="mono">0{i + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-label>Open menu</span>
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="menu env-ink" id="site-menu" data-menu hidden>
    <div class="menu__inner wrap">
      <nav aria-label="Mobile">
        <ol role="list" class="menu__list">
          <li>
            <a href="/" aria-current={path === '/' ? 'page' : undefined}>
              <span class="mono">00</span>Home
            </a>
          </li>
          {
            nav.map((item, i) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <span class="mono">0{i + 1}</span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="menu__foot">
        <p class="label">Products</p>
        <ul role="list">
          {
            products.map((p) => (
              <li>
                <a class="link" href={`/products/${p.slug}`}>
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="link mono menu__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--ink);
    pointer-events: none;
    transition:
      color 0.4s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .site-header[data-tone='dark'] {
    color: var(--paper);
  }
  .site-header[data-hidden='true']:not([data-open='true']) {
    transform: translateY(-110%);
  }
  .site-header__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 2;
    pointer-events: auto;
  }
  /* Soft legibility veil once the page has scrolled */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--header-h);
    background: var(--paper);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out), background 0.4s var(--ease-out);
    pointer-events: none;
    border-bottom: 1px solid var(--rule-paper);
  }
  .site-header[data-tone='dark']::before {
    background: var(--ink);
    border-bottom-color: var(--rule-ink);
  }
  .site-header[data-scrolled='true']::before {
    opacity: 0.94;
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-header[data-scrolled='true']::before {
      opacity: 0.82;
      backdrop-filter: blur(14px) saturate(1.2);
    }
  }
  .site-header[data-open='true']::before {
    opacity: 0;
  }

  .site-header__home {
    padding: 0.5rem 0;
  }

  .site-header__nav ul {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.75rem);
  }
  .site-header__nav a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .site-header__nav .mono {
    opacity: 0.5;
    font-size: 0.62rem;
  }
  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.45s var(--ease-out);
  }
  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }
  .site-header__nav a[aria-current='page']::after {
    background: var(--signal);
    height: 2px;
  }

  .site-header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
    align-items: center;
    justify-content: center;
  }
  .burger {
    position: relative;
    width: 1.5rem;
    height: 0.75rem;
  }
  .burger span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    transition: transform 0.5s var(--ease-out), width 0.5s var(--ease-out);
  }
  .burger span:first-child {
    top: 0;
    left: 30%;
  }
  .burger span:last-child {
    bottom: 0;
  }
  [aria-expanded='true'] .burger span:first-child {
    left: 0;
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .burger span:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* Mobile menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: auto;
    padding-top: var(--header-h);
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-io);
  }
  .menu[data-state='open'] {
    clip-path: inset(0 0 0 0);
  }
  .menu__inner {
    min-height: calc(100% - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding-block: 2rem 2.5rem;
  }
  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.35rem 0;
    font-size: clamp(2.6rem, 12vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .menu__list .mono {
    color: var(--fog);
    font-size: 0.75rem;
    transform: translateY(-1.2em);
  }
  .menu__list a[aria-current='page'] {
    color: var(--signal);
  }
  .menu__list li {
    border-bottom: 1px solid var(--rule-ink);
  }
  .menu__foot {
    display: grid;
    gap: 0.75rem;
  }
  .menu__foot ul {
    display: flex;
    gap: 1.5rem;
    font-size: 1.1rem;
  }
  .menu__mail {
    margin-top: 1rem;
    justify-self: start;
    text-transform: none;
    font-size: 0.85rem;
  }

  @media (max-width: 820px) {
    .site-header__nav {
      display: none;
    }
    .site-header__toggle {
      display: inline-flex;
    }
  }
  @media (min-width: 821px) {
    .menu {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && menu && label) {
    const initialTone = header.dataset.tone ?? 'light';

    /* Tone: follow whatever section sits under the header bar. */
    const toned = () => Array.from(document.querySelectorAll<HTMLElement>('[data-tone]:not([data-site-header])'));
    const updateTone = () => {
      if (header.dataset.open === 'true') return;
      const probe = 32;
      let tone = initialTone;
      for (const el of toned()) {
        const r = el.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe && r.height > 0) tone = el.dataset.tone ?? tone;
      }
      header.dataset.tone = tone;
    };

    /* Hide on scroll down, reveal on scroll up. */
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        header.dataset.scrolled = String(y > 24);
        if (Math.abs(y - lastY) > 6) {
          header.dataset.hidden = String(y > lastY && y > window.innerHeight * 0.6);
          lastY = y;
        }
        updateTone();
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();

    /* Mobile menu */
    let lastFocus: HTMLElement | null = null;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close menu' : 'Open menu';
      header.dataset.open = String(open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) {
        lastFocus = document.activeElement as HTMLElement;
        menu.hidden = false;
        header.dataset.tone = 'dark';
        requestAnimationFrame(() => {
          menu.dataset.state = 'open';
          menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
        });
      } else {
        menu.dataset.state = 'closed';
        const done = () => {
          if (menu.dataset.state === 'closed') menu.hidden = true;
        };
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) done();
        else menu.addEventListener('transitionend', done, { once: true });
        updateTone();
        lastFocus?.focus({ preventScroll: true });
      }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.dataset.open === 'true') setOpen(false);
      if (e.key === 'Tab' && header.dataset.open === 'true') {
        const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
    matchMedia('(min-width: 821px)').addEventListener('change', (e) => {
      if (e.matches && header.dataset.open === 'true') setOpen(false);
    });
  }
</script>
