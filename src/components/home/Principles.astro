---
/** 05 — Principles, written as axioms. */
import { principles } from '../../data/company';
---

<section id="principles" class="axioms" data-env="ink" data-tone="dark" aria-labelledby="axioms-title">
  <div class="wrap">
    <header class="axioms__head">
      <p class="label">05 — Principles</p>
      <h2 id="axioms-title" class="display" data-split>
        Axioms. <span class="serif">Things we hold true before we start.</span>
      </h2>
    </header>

    <ol class="axioms__list" role="list">
      {
        principles.map((p, i) => (
          <li class="axiom" data-reveal>
            <span class="axiom__n mono">Ax. {String(i + 1).padStart(2, '0')}</span>
            <h3 class="axiom__title">{p.title}</h3>
            <p class="axiom__body">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .axioms {
    padding-block: var(--section);
  }
  .axioms__head {
    display: grid;
    gap: 2rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .axioms__head .display {
    max-width: 16ch;
  }
  .axioms__list {
    border-top: 1px solid var(--fg);
  }
  .axiom {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid var(--rule);
  }
  .axiom::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: -0.45rem;
    background: var(--signal);
    transform: scale(0);
    transition: transform 0.5s var(--ease-out);
  }
  .axiom__n {
    color: var(--muted);
    transition: transform 0.5s var(--ease-out), opacity 0.3s;
  }
  .axiom__title {
    font-size: clamp(1.7rem, 3.4vw, 3.2rem);
    font-weight: 580;
    letter-spacing: -0.04em;
    line-height: 1.02;
    transition: transform 0.6s var(--ease-out);
  }
  .axiom__body {
    color: var(--muted);
    max-width: 40ch;
  }
  @media (hover: hover) {
    .axiom:hover::before {
      transform: scale(1);
    }
    .axiom:hover .axiom__n {
      opacity: 0;
    }
    .axiom:hover .axiom__title {
      transform: translateX(0.4em);
    }
  }
  @media (max-width: 820px) {
    .axiom {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
