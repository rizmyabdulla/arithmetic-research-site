---
/**
 * 03 — Ecosystem. The company as a sum; products as its terms.
 * The orbit is generated from src/data/products.ts and always leaves room
 * for the next, undefined term.
 */
import { products, subscript, statusLabel } from '../../data/products';
import Arrow from '../Arrow.astro';

const futureSlots = 2;
const terms = [
  ...products.map((p, i) => ({ kind: 'product' as const, label: p.name, idx: i + 1, p })),
  ...Array.from({ length: futureSlots }, (_, j) => ({
    kind: 'future' as const,
    label: '?',
    idx: products.length + j + 1,
    p: null,
  })),
];

// Place terms on two rings, alternating, at evenly spaced angles.
const nodes = terms.map((t, i) => {
  const ring = i % 2 === 0 ? 140 : 205;
  const angle = -90 + (360 / terms.length) * i + (i % 2 ? 18 : 0);
  const rad = (angle * Math.PI) / 180;
  return { ...t, x: 300 + Math.cos(rad) * ring, y: 300 + Math.sin(rad) * ring, angle };
});
---

<section id="ecosystem" class="eco" data-env="paper" data-tone="light" aria-labelledby="eco-title">
  <div class="wrap eco__grid">
    <div class="eco__copy">
      <p class="label">03 — Ecosystem</p>
      <h2 id="eco-title" class="display" data-split>
        The company is the sum. <span class="serif">The products are its terms.</span>
      </h2>

      <p class="eco__formula mono" aria-label="Arithmetic Research equals the sum of x n, for n from 1 upward">
        <span>AR</span><span class="eco__op">=</span><span class="eco__sigma">Σ</span><span>xₙ</span>
        <span class="muted">n = 1 … ∞</span>
      </p>

      <p class="lead muted" data-reveal>
        Arithmetic Research is the parent company. Each product is a distinct business with its own identity and
        its own customers, built on shared research, engineering and infrastructure.
      </p>

      <ul class="eco__terms" role="list" data-stagger>
        {
          terms.map((t) =>
            t.kind === 'product' ? (
              <li>
                <a class="eco__term" href={`/products/${t.p.slug}`} data-term={t.idx}>
                  <span class="mono eco__x">x{subscript(t.idx)}</span>
                  <span class="eco__name">{t.p.name}</span>
                  <span class="eco__cat muted">{t.p.category}</span>
                  <span class="mono eco__status">{statusLabel[t.p.status]}</span>
                  <Arrow />
                </a>
              </li>
            ) : (
              <li class="eco__term eco__term--future" data-term={t.idx}>
                <span class="mono eco__x">x{subscript(t.idx)}</span>
                <span class="eco__name">Undefined</span>
                <span class="eco__cat muted">In development. Revealed when it can stand on its own.</span>
              </li>
            ),
          )
        }
      </ul>
    </div>

    <figure class="eco__figure" aria-hidden="true">
      <svg class="eco__orbit" viewBox="-40 -40 680 680" data-orbit>
        <defs>
          <pattern id="eco-dots" width="12" height="12" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="0.8" class="eco__dot"></circle>
          </pattern>
        </defs>
        <circle cx="300" cy="300" r="290" fill="url(#eco-dots)" class="eco__field"></circle>
        <circle cx="300" cy="300" r="140" class="eco__ring"></circle>
        <circle cx="300" cy="300" r="205" class="eco__ring eco__ring--dash"></circle>
        <circle cx="300" cy="300" r="75" class="eco__ring"></circle>

        <g data-orbit-spin>
          {
            nodes.map((n) => (
              <g>
                <line x1="300" y1="300" x2={n.x} y2={n.y} class:list={['eco__spoke', n.kind === 'future' && 'is-future']} data-node={n.idx} />
              </g>
            ))
          }
          {
            nodes.map((n) => (
              <g class:list={['eco__node', n.kind === 'future' && 'is-future']} transform={`translate(${n.x} ${n.y})`} data-node={n.idx}>
                <g data-orbit-counter>
                  {n.kind === 'product' ? (
                    <rect x="-13" y="-13" width="26" height="26" style={`fill:${n.p.theme.accent}`} />
                  ) : (
                    <rect x="-13" y="-13" width="26" height="26" class="eco__ghost" />
                  )}
                  <text y="38" text-anchor="middle" class="eco__label">
                    {n.kind === 'product' ? n.p.name : `x${subscript(n.idx)} = ?`}
                  </text>
                </g>
              </g>
            ))
          }
        </g>

        <g transform="translate(300 300)">
          <rect x="-34" y="-34" width="68" height="68" class="eco__core" />
          <g transform="translate(-20 -20) scale(1.25)">
            <rect x="2" y="8" width="6" height="6" class="eco__core-carry" />
            <rect x="11" y="8" width="19" height="6" class="eco__core-bar" />
            <rect x="2" y="18" width="28" height="6" class="eco__core-bar" />
          </g>
        </g>
      </svg>
      <figcaption class="mono muted eco__cap">Fig. 3 — The ecosystem, open-ended by design</figcaption>
    </figure>
  </div>
</section>

<style>
  .eco {
    padding-block: var(--section);
  }
  .eco__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 6vw, 7rem);
    align-items: center;
  }
  .eco__copy {
    display: grid;
    gap: 2rem;
  }
  .eco__copy .display {
    font-size: clamp(2.4rem, 5.2vw, 5.6rem);
  }
  .eco__formula {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    font-size: clamp(1.4rem, 2.4vw, 2.2rem);
    text-transform: none;
    letter-spacing: 0;
  }
  .eco__formula .muted {
    font-size: 0.8rem;
  }
  .eco__op {
    color: var(--accent);
  }
  .eco__sigma {
    font-family: var(--f-serif);
    font-size: 1.5em;
    line-height: 0.8;
  }
  .eco__terms {
    border-top: 1px solid var(--fg);
  }
  .eco__term {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 1.25rem;
    grid-template-areas:
      'x name status arrow'
      'x cat cat cat';
    column-gap: 1rem;
    row-gap: 0.15rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
    transition: padding 0.5s var(--ease-out), background-color 0.5s var(--ease-out);
  }
  a.eco__term:hover,
  a.eco__term:focus-visible,
  .eco__term.is-hot {
    padding-left: 0.75rem;
    background: color-mix(in srgb, var(--fg) 5%, transparent);
  }
  .eco__x {
    grid-area: x;
    color: var(--signal-ink);
    font-size: 0.85rem;
    text-transform: none;
  }
  .eco__name {
    grid-area: name;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-weight: 580;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .eco__cat {
    grid-area: cat;
    font-size: 0.92rem;
  }
  .eco__status {
    grid-area: status;
    color: var(--muted);
  }
  .eco__term :global(.arrow) {
    grid-area: arrow;
    align-self: center;
    transition: transform 0.5s var(--ease-out);
  }
  a.eco__term:hover :global(.arrow) {
    transform: translateX(4px);
  }
  .eco__term--future .eco__name {
    color: var(--muted);
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
  }

  .eco__figure {
    position: relative;
    margin: 0;
  }
  .eco__orbit {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .eco__dot {
    fill: var(--fg);
    opacity: 0.18;
  }
  .eco__ring {
    fill: none;
    stroke: var(--fg);
    stroke-opacity: 0.25;
    stroke-width: 1;
  }
  .eco__ring--dash {
    stroke-dasharray: 3 6;
  }
  .eco__spoke {
    stroke: var(--fg);
    stroke-opacity: 0.35;
    stroke-width: 1;
    transition: stroke 0.4s, stroke-opacity 0.4s;
  }
  .eco__spoke.is-future {
    stroke-dasharray: 2 5;
    stroke-opacity: 0.25;
  }
  .eco__spoke.is-hot {
    stroke: var(--signal);
    stroke-opacity: 1;
    stroke-width: 1.5;
  }
  .eco__node rect {
    transition: transform 0.5s var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
  }
  .eco__node.is-hot rect {
    transform: scale(1.35) rotate(45deg);
  }
  .eco__ghost {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-dasharray: 3 3;
  }
  .eco__label {
    font-family: var(--f-mono);
    font-size: 13px;
    fill: var(--fg);
    letter-spacing: 0.02em;
  }
  .eco__node.is-future .eco__label {
    fill: var(--muted);
  }
  .eco__core {
    fill: var(--fg);
  }
  .eco__core-bar {
    fill: var(--bg);
  }
  .eco__core-carry {
    fill: var(--signal);
  }
  .eco__cap {
    margin-top: 1rem;
    text-align: center;
    text-transform: none;
  }

  @media (max-width: 960px) {
    .eco__grid {
      grid-template-columns: 1fr;
    }
    .eco__figure {
      max-width: 34rem;
      padding-inline: 6%;
      width: 100%;
      justify-self: center;
    }
  }
  @media (max-width: 520px) {
    .eco__term {
      grid-template-columns: 2.25rem minmax(0, 1fr) 1.25rem;
      grid-template-areas:
        'x name arrow'
        'x cat cat'
        'x status status';
    }
    .eco__status {
      margin-top: 0.35rem;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../../scripts/motion';

  const svg = document.querySelector<SVGSVGElement>('[data-orbit]');
  const section = svg?.closest('section');
  if (svg && section) {
    // Link list items and orbit nodes.
    section.querySelectorAll<HTMLElement>('[data-term]').forEach((term) => {
      const id = term.dataset.term;
      const targets = svg.querySelectorAll(`[data-node="${id}"]`);
      const on = () => {
        term.classList.add('is-hot');
        targets.forEach((t) => t.classList.add('is-hot'));
      };
      const off = () => {
        term.classList.remove('is-hot');
        targets.forEach((t) => t.classList.remove('is-hot'));
      };
      term.addEventListener('pointerenter', on);
      term.addEventListener('pointerleave', off);
      term.addEventListener('focusin', on);
      term.addEventListener('focusout', off);
    });

    if (!reducedMotion()) {
      const spin = svg.querySelector('[data-orbit-spin]');
      const counters = svg.querySelectorAll('[data-orbit-counter]');
      const st = { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1 };
      gsap.fromTo(spin, { rotate: -40 }, { rotate: 50, ease: 'none', svgOrigin: '300 300', scrollTrigger: st });
      gsap.fromTo(counters, { rotate: 40 }, { rotate: -50, ease: 'none', scrollTrigger: st });
      const parts = svg.querySelectorAll('.eco__node, .eco__spoke');
      gsap.set(parts, { opacity: 0 });
      gsap.to(parts, {
        opacity: 1,
        stagger: 0.06,
        duration: 1.2,
        scrollTrigger: { trigger: svg, start: 'top 80%', once: true },
      });
    }
  }
</script>
