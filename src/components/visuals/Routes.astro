---
/**
 * Kordify motif — a dispatch board: streets, jobs, technicians and the
 * routes the scheduler draws between them. Illustrative, not product UI.
 */
const size = 600;
const step = 60;
const lines = Array.from({ length: size / step + 1 }, (_, i) => i * step);
const jobs = [
  { x: 420, y: 120, label: 'HVAC · priority' },
  { x: 480, y: 420, label: 'Electrical' },
  { x: 180, y: 480, label: 'Plumbing' },
];
const techs = [
  { x: 120, y: 180 },
  { x: 300, y: 300 },
  { x: 540, y: 240 },
];
// Manhattan routes along the street grid
const routes = [
  'M120 180 H300 V120 H420',
  'M300 300 V420 H480',
  'M540 240 V360 H360 V480 H180',
];
---

<svg class="viz viz--routes" viewBox={`0 0 ${size} ${size}`} role="img" aria-label="Illustration: a dispatch map with technicians routed to jobs">
  <g class="viz__grid">
    {lines.map((v) => <line x1={v} y1="0" x2={v} y2={size} />)}
    {lines.map((v) => <line x1="0" y1={v} x2={size} y2={v} />)}
  </g>
  <g class="viz__blocks">
    <rect x="66" y="246" width="108" height="48" />
    <rect x="366" y="246" width="48" height="108" />
    <rect x="186" y="366" width="108" height="48" />
    <rect x="426" y="486" width="108" height="48" />
    <rect x="186" y="66" width="48" height="48" />
  </g>
  <g class="viz__routes">
    {routes.map((d, i) => <path d={d} pathLength="1" data-route style={`--i:${i}`} />)}
  </g>
  <g class="viz__jobs">
    {
      jobs.map((j, i) => (
        <g transform={`translate(${j.x} ${j.y})`} style={`--i:${i}`}>
          <circle r="22" class="viz__sla" />
          <rect x="-9" y="-9" width="18" height="18" />
          <text x="18" y="-16" class="viz__label">{j.label}</text>
        </g>
      ))
    }
  </g>
  <g class="viz__techs">
    {techs.map((t) => <circle cx={t.x} cy={t.y} r="7" />)}
  </g>
  <g class="viz__legend" transform="translate(16 584)">
    <rect x="0" y="-8" width="9" height="9" class="viz__legend-job" />
    <text x="16" y="0" class="viz__label">job</text>
    <circle cx="66" cy="-3.5" r="4.5" class="viz__legend-tech" />
    <text x="78" y="0" class="viz__label">technician</text>
    <line x1="168" y1="-3.5" x2="194" y2="-3.5" class="viz__legend-route" />
    <text x="202" y="0" class="viz__label">suggested route</text>
  </g>
</svg>

<style>
  .viz {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .viz__grid line {
    stroke: var(--fg);
    stroke-opacity: 0.1;
    stroke-width: 1;
  }
  .viz__blocks rect {
    fill: var(--fg);
    fill-opacity: 0.06;
  }
  .viz__routes path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .viz__jobs rect {
    fill: var(--accent);
  }
  .viz__sla {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: sla 3s var(--ease-out) infinite;
    animation-delay: calc(var(--i) * 0.9s);
  }
  @keyframes sla {
    0% {
      transform: scale(0.4);
      stroke-opacity: 0.9;
    }
    100% {
      transform: scale(1.6);
      stroke-opacity: 0;
    }
  }
  .viz__techs circle {
    fill: var(--fg);
    stroke: var(--bg);
    stroke-width: 3;
  }
  .viz__label {
    font-family: var(--f-mono);
    font-size: 12px;
    fill: var(--fg);
    fill-opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .viz__legend-job {
    fill: var(--accent);
  }
  .viz__legend-tech {
    fill: var(--fg);
  }
  .viz__legend-route {
    stroke: var(--accent);
    stroke-width: 3;
  }
</style>
