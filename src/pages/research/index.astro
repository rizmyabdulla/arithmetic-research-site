---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Arrow from '../../components/Arrow.astro';
import { focusAreas } from '../../data/company';
import { getProduct } from '../../data/products';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const kinds = { research: 'Research', engineering: 'Engineering', experiment: 'Experiment' } as const;
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Base
  title="Research"
  description="Research and capabilities at Arithmetic Research: intelligent agents, decision support, workflow automation and resilient software systems — and a notebook of our technical work."
  tone="dark"
>
  <PageHero
    label="Research & capabilities"
    lead="We do research in order to ship. Each focus area below is grounded in a product that is already running — and the notebook is where we will publish what we learn along the way."
    fig={`Fig. R — ${focusAreas.length} focus areas, each tied to shipped work`}
  >
    <Fragment slot="title">Notes from <span class="serif">the workbench.</span></Fragment>
    <svg slot="figure" class="rfig" viewBox="0 0 200 200" aria-hidden="true">
      {
        Array.from({ length: 10 }, (_, y) =>
          Array.from({ length: 10 }, (_, x) => (
            <rect
              x={x * 20 + 4}
              y={y * 20 + 4}
              width="12"
              height="12"
              class:list={[(x * 7 + y * 3) % 11 === 0 && 'on', (x + y * 5) % 13 === 0 && 'hot']}
              style={`--d:${((x + y) % 10) * 0.12}s`}
            />
          )),
        )
      }
    </svg>
  </PageHero>

  <section class="areas env-paper" data-tone="light" aria-labelledby="areas-title">
    <div class="wrap">
      <div class="areas__head">
        <p class="label">Focus areas</p>
        <h2 id="areas-title" class="h1" data-split>Where we <span class="serif">push.</span></h2>
        <p class="muted measure" data-reveal>
          We only list areas where our own products already depend on the work. New areas appear here when they do too.
        </p>
      </div>

      <ol class="areas__list" role="list">
        {
          focusAreas.map((a) => {
            const product = getProduct(a.product);
            return (
              <li class="area" data-reveal>
                <span class="mono area__code">{a.code}</span>
                <h3 class="area__title">{a.title}</h3>
                <p class="area__body">{a.body}</p>
                <p class="area__ground mono">
                  <span class="area__dot" style={product ? `background:${product.theme.accent}` : ''} />
                  {product ? (
                    <a class="link" href={`/products/${product.slug}`}>
                      {a.grounding}
                    </a>
                  ) : (
                    a.grounding
                  )}
                </p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <section class="notebook env-ink" data-tone="dark" aria-labelledby="notebook-title" id="notebook">
    <div class="wrap">
      <div class="notebook__head">
        <p class="label">Notebook</p>
        <h2 id="notebook-title" class="h1" data-split>Research, engineering <span class="serif">&amp; experiments.</span></h2>
        <ul class="notebook__kinds mono" role="list" aria-label="Kinds of notes">
          {Object.values(kinds).map((k) => <li>{k}</li>)}
        </ul>
      </div>

      {
        notes.length > 0 ? (
          <ol class="notes" role="list">
            {notes.map((n) => (
              <li>
                <a class="note" href={`/research/${n.id}`}>
                  <span class="mono note__meta">
                    <time datetime={n.data.date.toISOString()}>{fmt.format(n.data.date)}</time>
                    <span>{kinds[n.data.kind]}</span>
                    {n.data.area && <span>{n.data.area}</span>}
                  </span>
                  <span class="note__title">{n.data.title}</span>
                  <span class="note__desc muted">{n.data.description}</span>
                  <Arrow />
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty" data-reveal>
            <div class="empty__glyph" aria-hidden="true">
              <span class="empty__cursor" />
            </div>
            <div class="empty__copy">
              <p class="empty__title">The first page is still blank.</p>
              <p class="muted">
                We have not published any notes yet. When we do, technical articles, experiments and engineering
                write-ups from the work behind our products will be listed here, newest first.
              </p>
              <a class="link" href="/contact?topic=collab">
                Want to work on these problems with us? Get in touch
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .rfig {
    width: min(18rem, 70%);
    margin-left: auto;
  }
  .rfig rect {
    fill: none;
    stroke: var(--paper);
    stroke-opacity: 0.22;
  }
  .rfig .on {
    fill: var(--paper);
    stroke: none;
    animation: blink 3.2s var(--ease-io) infinite;
    animation-delay: var(--d);
  }
  .rfig .hot {
    fill: var(--signal);
    stroke: none;
  }
  @keyframes blink {
    50% {
      fill-opacity: 0.15;
    }
  }

  .areas {
    padding-block: var(--section);
  }
  .areas__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .areas__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--fg);
  }
  .area {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.75rem, 3vw, 2.75rem) clamp(1.5rem, 3vw, 2.75rem) clamp(2rem, 3.5vw, 3rem) 0;
    border-bottom: 1px solid var(--rule);
  }
  .area:nth-child(2n) {
    padding-left: clamp(1.5rem, 3vw, 2.75rem);
    padding-right: 0;
    border-left: 1px solid var(--rule);
  }
  .area__code {
    color: var(--signal-ink);
  }
  .area__title {
    font-size: clamp(1.7rem, 2.8vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .area__body {
    color: var(--muted);
    max-width: 46ch;
  }
  .area__ground {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .area__dot {
    width: 0.6rem;
    height: 0.6rem;
    flex: none;
  }

  .notebook {
    padding-block: var(--section);
  }
  .notebook__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .notebook__kinds {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .notebook__kinds li {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--rule);
    color: var(--muted);
  }
  .notes {
    border-top: 1px solid var(--fg);
  }
  .note {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) 1.5rem;
    grid-template-areas: 'meta title arrow' 'meta desc arrow';
    gap: 0.4rem 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
    transition: padding 0.5s var(--ease-out);
  }
  .note:hover,
  .note:focus-visible {
    padding-left: 1rem;
  }
  .note__meta {
    grid-area: meta;
    display: grid;
    gap: 0.3rem;
    color: var(--muted);
  }
  .note__title {
    grid-area: title;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 580;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .note__desc {
    grid-area: desc;
  }
  .note :global(.arrow) {
    grid-area: arrow;
    align-self: center;
  }

  .empty {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px dashed var(--rule-ink);
    border-color: rgb(236 235 229 / 0.25);
  }
  .empty__glyph {
    aspect-ratio: 4 / 3;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 24px 24px;
    position: relative;
  }
  .empty__cursor {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 3px;
    height: 24px;
    background: var(--signal);
    animation: caret 1.1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .empty__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 40ch;
  }
  .empty__title {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 580;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  @media (max-width: 820px) {
    .areas__list,
    .empty {
      grid-template-columns: 1fr;
    }
    .area,
    .area:nth-child(2n) {
      padding-left: 0;
      padding-right: 0;
      border-left: 0;
    }
    .note {
      grid-template-columns: minmax(0, 1fr) 1.5rem;
      grid-template-areas: 'meta arrow' 'title arrow' 'desc arrow';
    }
  }
</style>
