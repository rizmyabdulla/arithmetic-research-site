---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site, inquiryTypes } from '../data/site';
import { products } from '../data/products';
---

<Base
  title="Contact"
  description="Contact Arithmetic Research about Kordify, VoiceAgento, partnerships, research collaboration or anything else."
  tone="dark"
>
  <section class="contact env-ink" data-tone="dark" aria-labelledby="contact-title">
    <div class="wrap contact__grid">
      <div class="contact__intro">
        <p class="label">Contact</p>
        <h1 id="contact-title" class="contact__title" data-split>
          Let’s work it <span class="serif">out.</span>
        </h1>
        <p class="lead muted" data-reveal data-delay="0.3">
          Prospective customers, partners, collaborators, press or investors: tell us what you are working on and the
          right person will write back.
        </p>

        <div class="contact__direct" data-reveal data-delay="0.45">
          <p class="mono muted">Write directly</p>
          <div class="contact__mail">
            <a class="contact__mail-link" href={`mailto:${site.email}`}>{site.email}</a>
            <button class="mono contact__copy" type="button" data-copy={site.email} aria-live="polite">Copy</button>
          </div>
        </div>

        <div class="contact__products" data-reveal data-delay="0.55">
          <p class="mono muted">Looking for a product?</p>
          <p class="muted">
            For pricing, demos and sign-ups you can also go straight to{' '}
            {
              products.map((p, i) => (
                <>
                  <a class="link" href={p.url} target="_blank" rel="noopener">
                    {p.name}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                  {i < products.length - 2 ? ', ' : i === products.length - 2 ? ' and ' : '.'}
                </>
              ))
            }
          </p>
        </div>
      </div>

      <form class="form" data-contact-form novalidate aria-describedby="form-note">
        <fieldset class="form__topics">
          <legend class="mono">01 — What is this about?</legend>
          <div class="form__topic-grid">
            {
              inquiryTypes.map((t, i) => (
                <label class="topic">
                  <input type="radio" name="topic" value={t.id} checked={i === 0} />
                  <span class="topic__box">
                    <span class="topic__label">{t.label}</span>
                    <span class="topic__blurb">{t.blurb}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="form__fields">
          <legend class="mono">02 — About you</legend>
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
            <p class="field__error" id="f-name-err" hidden>Please tell us your name.</p>
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required />
            <p class="field__error" id="f-email-err" hidden>Please enter a valid email address.</p>
          </div>
          <div class="field">
            <label for="f-org">Organization <span class="muted">(optional)</span></label>
            <input id="f-org" name="org" type="text" autocomplete="organization" />
          </div>
        </fieldset>

        <fieldset class="form__fields">
          <legend class="mono">03 — The problem</legend>
          <div class="field">
            <label for="f-msg">Message</label>
            <textarea id="f-msg" name="message" rows="6" required></textarea>
            <p class="field__error" id="f-msg-err" hidden>A few lines about what you need will help us route it.</p>
          </div>
        </fieldset>

        <div class="form__submit">
          <button class="btn form__btn" type="submit">Compose email <Arrow /></button>
          <p class="form__note muted" id="form-note">
            This opens your email app with your message ready to send to {site.email}. Nothing is sent or stored by this
            website.
          </p>
        </div>
        <p class="form__status" role="status" aria-live="polite" data-form-status></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding: calc(var(--header-h) + clamp(3rem, 9vh, 7rem)) 0 var(--section);
    min-height: 100vh;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: start;
  }
  .contact__intro {
    display: grid;
    gap: 2rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .contact__title {
    font-size: clamp(3.2rem, 8.5vw, 9rem);
    font-weight: 650;
    letter-spacing: -0.06em;
    line-height: 0.88;
  }
  .contact__title .serif {
    color: var(--signal);
  }
  .contact__direct,
  .contact__products {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
  }
  .contact__mail-link {
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    word-break: break-all;
    background-image: linear-gradient(var(--signal), var(--signal));
    background-size: 100% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
  }
  .contact__copy {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--rule);
    border-color: rgb(236 235 229 / 0.25);
    color: var(--paper);
    transition: background-color 0.3s, color 0.3s;
  }
  .contact__copy:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .form {
    display: grid;
    gap: 2.75rem;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  legend {
    color: var(--fog);
    margin-bottom: 1.25rem;
    padding: 0;
  }
  .form__topic-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .topic {
    position: relative;
    cursor: pointer;
  }
  .topic input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .topic__box {
    display: grid;
    gap: 0.4rem;
    height: 100%;
    padding: 1.1rem 1.2rem 1.2rem;
    border: 1px solid rgb(236 235 229 / 0.2);
    transition: border-color 0.3s, background-color 0.3s, color 0.3s;
  }
  .topic__label {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.015em;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .topic__label::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid currentColor;
    flex: none;
    transition: background-color 0.3s, border-color 0.3s;
  }
  .topic__blurb {
    color: var(--fog);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .topic:hover .topic__box {
    border-color: rgb(236 235 229 / 0.5);
  }
  .topic input:checked + .topic__box {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .topic input:checked + .topic__box .topic__blurb {
    color: var(--graphite);
  }
  .topic input:checked + .topic__box .topic__label::before {
    background: var(--signal);
    border-color: var(--signal);
  }
  .topic input:focus-visible + .topic__box {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .form__fields {
    display: grid;
    gap: 1.5rem;
  }
  .field {
    display: grid;
    gap: 0.5rem;
  }
  .field label {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .field input,
  .field textarea {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgb(236 235 229 / 0.35);
    padding: 0.7rem 0;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    border-radius: 0;
    transition: border-color 0.3s;
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
    line-height: 1.5;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--signal);
    box-shadow: 0 1px 0 0 var(--signal);
  }
  .field [aria-invalid='true'] {
    border-bottom-color: #ff7a52;
  }
  .field__error {
    color: #ff8a66;
    font-size: 0.88rem;
  }
  .form__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    padding-top: 0.5rem;
  }
  .form__btn {
    --btn-bg: var(--signal);
    --btn-fg: var(--ink);
  }
  .form__btn::before {
    background: var(--paper);
  }
  .form__note {
    font-size: 0.88rem;
    max-width: 34ch;
  }
  .form__status:empty {
    display: none;
  }
  .form__status {
    padding: 1rem 1.2rem;
    border-left: 2px solid var(--signal);
    background: rgb(236 235 229 / 0.05);
  }

  @media (max-width: 960px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .contact__intro {
      position: relative;
      top: 0;
    }
  }
  @media (max-width: 540px) {
    .form__topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { site, inquiryTypes } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  // Preselect a topic from ?topic=partner etc.
  const topic = new URLSearchParams(location.search).get('topic');
  if (form && topic) {
    const radio = form.querySelector<HTMLInputElement>(`input[name="topic"][value="${CSS.escape(topic)}"]`);
    if (radio) radio.checked = true;
  }

  const fields = {
    name: { el: () => form!.elements.namedItem('name') as HTMLInputElement, ok: (v: string) => v.trim().length > 1 },
    email: {
      el: () => form!.elements.namedItem('email') as HTMLInputElement,
      ok: (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()),
    },
    message: {
      el: () => form!.elements.namedItem('message') as HTMLTextAreaElement,
      ok: (v: string) => v.trim().length > 9,
    },
  };
  const errId = { name: 'f-name-err', email: 'f-email-err', message: 'f-msg-err' } as const;

  const check = (key: keyof typeof fields) => {
    const input = fields[key].el();
    const valid = fields[key].ok(input.value);
    const err = document.getElementById(errId[key])!;
    err.hidden = valid;
    input.setAttribute('aria-invalid', String(!valid));
    if (!valid) input.setAttribute('aria-describedby', errId[key]);
    else input.removeAttribute('aria-describedby');
    return valid;
  };

  if (form && status) {
    (Object.keys(fields) as (keyof typeof fields)[]).forEach((key) =>
      fields[key].el().addEventListener('blur', () => {
        if (fields[key].el().value) check(key);
      }),
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const keys = Object.keys(fields) as (keyof typeof fields)[];
      const results = keys.map(check);
      const firstBad = keys.find((_, i) => !results[i]);
      if (firstBad) {
        fields[firstBad].el().focus();
        status.textContent = 'A few details are missing. Check the highlighted fields.';
        return;
      }

      const data = new FormData(form);
      const topicId = String(data.get('topic') ?? 'other');
      const topicLabel = inquiryTypes.find((t) => t.id === topicId)?.label ?? 'Inquiry';
      const name = String(data.get('name')).trim();
      const org = String(data.get('org') ?? '').trim();
      const subject = `[${topicLabel}] ${name}${org ? ` — ${org}` : ''}`;
      const details = [`Name: ${name}`, `Email: ${String(data.get('email')).trim()}`];
      if (org) details.push(`Organization: ${org}`);
      details.push(`Topic: ${topicLabel}`);
      const body = [String(data.get('message')).trim(), '', '—', ...details].join('\n');

      const href = `mailto:${site.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = href;
      status.textContent = `Your email app should now be open with the message ready to send. If nothing happened, copy your message and write to ${site.email}.`;
    });
  }

  // Copy-to-clipboard for the address
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select & copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2200);
    });
  });
</script>
